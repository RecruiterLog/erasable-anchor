{
  "name": "erasable-anchor",
  "version": "0.1.0",
  "description": "Merkle anchoring where deleting a record permanently severs its leaf, without invalidating any other proof.",
  "license": "Apache-2.0",
  "author": "RecruiterLog",
  "homepage": "https://github.com/RecruiterLog/erasable-anchor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RecruiterLog/erasable-anchor.git"
  },
  "bugs": {
    "url": "https://github.com/RecruiterLog/erasable-anchor/issues"
  },
  "keywords": [
    "merkle",
    "merkle-tree",
    "anchoring",
    "solana",
    "gdpr",
    "popia",
    "right-to-erasure",
    "crypto-shredding",
    "tamper-evident"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "SPEC.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0"
  }
}
